# 复制为 .env 并填入真实值（.env 不进 git）

# —— 飞书（必填）——
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_CHAT_ID=oc_xxx

# —— daemon：仓库映射与并发（npm run daemon 必填）——
PIPELINE_REPOS={"lakeghost":"D:/work/lake_spirit"}
PIPELINE_DEFAULT_REPO=lakeghost
PIPELINE_MAX_CONCURRENCY=2
PIPELINE_TICKET_PREFIX=LS
# 并行工单开 worktree 时的基线分支（默认取 origin 默认分支）
# PIPELINE_BASE_REF=feature/docs

# —— 可选开关 ——
# PIPELINE_DOUBLE_REVIEW=1        # review 跑两轮独立评审、取严（约 +$3/单）

# —— Jenkins（可选：设置后 review 通过 → 上线审批 → 构建；任务需参数化 TICKET/BRANCH）——
# JENKINS_URL=http://jenkins.hbo-vps.com
# JENKINS_JOB=your-app-deploy
# JENKINS_USER=songxulin
# JENKINS_TOKEN=xxx

# —— GitLab MR 评审服务（npm run webhook 用）——
GITLAB_URL=http://git.happotech.com
GITLAB_API_TOKEN=xxx
GITLAB_WEBHOOK_SECRET=pipeline-e2e-secret
GITLAB_REPO_MAP={"songxulin/lakeghost":"D:/work/lake_spirit"}
GITLAB_TRIGGER=@ai-review
