# pipeline-orchestrator 配置模板（2026-08-18 重写，与代码实际读取的键对齐）
# 复制为 .env 填值。.env 已在 .gitignore，永不入库。
# ⚠ 手动编辑 .env 时保持 UTF-8 编码，且不要删行——2026-08-18 曾因轮换凭据时重写文件丢掉下面大半配置。

# ===== 飞书（必填，daemon 启动硬依赖）=====
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_CHAT_ID=oc_xxx                  # 业务群 chat_id，用 scripts/list-chats.mjs 获取
FEISHU_OWNER_OPEN_ID=ou_xxx            # 看板/云文档归属人；不填则归机器人所有，人看不到

# ===== 项目注册表（必填，daemon 启动硬依赖）=====
# 一行 JSON：alias → { repo 本地路径, prefix 工单号前缀, gitlab 项目路径, jenkins 任务名, wikiArchive/wikiKnowledge 节点 }
PIPELINE_PROJECTS={"lakeghost":{"repo":"D:/work/lake_spirit","prefix":"LS","gitlab":"group/project","jenkins":"job-name","wikiArchive":"wikcnXXX","wikiKnowledge":"wikcnYYY"}}

# ===== GitLab（webhook 服务必填）=====
GITLAB_URL=http://git.example.com
GITLAB_API_TOKEN=glpat-xxx             # PAT，需 api 权限
GITLAB_WEBHOOK_SECRET=xxx
GITLAB_REPO_MAP={"group/project":"D:/work/local-clone"}
GITLAB_TRIGGER=@ai-review              # 可选，默认 @ai-review
GITLAB_WEBHOOK_PORT=8377               # 可选，默认 8377

# ===== Jenkins（配了才走 CI 阶段；配 JOB 必须同时配 USER/TOKEN）=====
JENKINS_URL=http://jenkins.example.com
JENKINS_JOB=pipeline-job
JENKINS_USER=xxx
JENKINS_TOKEN=xxx
JENKINS_TIMEOUT_MIN=30                 # 可选，默认 30

# ===== 多维表格看板 + 知识库 + 术语表（可选，缺则静默跳过投影与注入）=====
BITABLE_APP_TOKEN=bascnXXX             # 看板链接 https://feishu.cn/base/<这段>
BITABLE_TICKET_TABLE_ID=tblXXX
BITABLE_NODE_TABLE_ID=tblXXX
BITABLE_KB_TABLE_ID=tblXXX
BITABLE_GLOSSARY_TABLE_ID=tblXXX       # scripts/glossary-setup.ts 创建

# ===== Wiki 归档（可选）=====
WIKI_SPACE_ID=xxx
WIKI_ARCHIVE_NODE=wikcnXXX             # scripts/kb-setup.ts 创建
WIKI_KNOWLEDGE_NODE=wikcnXXX
WIKI_URL=https://xxx.feishu.cn/wiki/xxx  # 仅面板展示

# ===== 行为开关（全部可选，有默认值）=====
# PIPELINE_CLASSIFY_MODEL=sonnet       # 意图识别模型（haiku 实测 5/8，勿降级）
# PIPELINE_RUN_MODEL=sonnet            # /run 模型
# PIPELINE_RUN_BUDGET=3                # /run 单次预算（美元）
# PIPELINE_MAX_CONCURRENCY=2           # 并发 claude 会话数
# PIPELINE_DEFAULT_REPO=lakeghost      # 未指明项目时的默认
# PIPELINE_DOUBLE_REVIEW=1             # 双评审取严
# PIPELINE_BASE_REF=origin/master      # review diff 基点覆盖
# PIPELINE_PLUGIN_DIR=../pipeline-plugin
# PIPELINE_HINTS_OFF=1                 # 对照模式：关闭知识/术语注入（面板会显式标注）
